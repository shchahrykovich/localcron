{
  "id": 1,
  "method": "allow_job_secrets",
  "params": {
    "job": {
      "id": "nightly-deploy",
      "schedule": "0 2 * * *",
      "kind": "shell",
      "command": "./scripts/deploy.sh",
      "dir": "/Users/me/shop",
      "secret_env": {
        "GH_TOKEN": "github-token"
      },
      "enabled": true,
      "catch_up": true,
      "timeout_secs": 3600,
      "updated_at": "2026-10-29T13:30:00Z"
    }
  }
}
