{
  "id": 1,
  "method": "set_job",
  "params": {
    "job": {
      "id": "nightly-deploy",
      "schedule": "0 2 * * *",
      "kind": "shell",
      "command": "./scripts/deploy.sh",
      "dir": "/Users/me/shop",
      "secret_env": {
        "GH_TOKEN": "github-token"
      }
    },
    "replace": false
  }
}
